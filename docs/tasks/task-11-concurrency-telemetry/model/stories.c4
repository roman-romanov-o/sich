// stories.c4 — task-11-concurrency-telemetry user stories as walkable flows.
// AC text/status authority lives in ../progress.yaml; steps cite AC ids only.

model {
  us-001 = story 'US-001: Record every WORKING interval durably' {
    #must
    description '''
      As the board runtime, I want every completed WORKING interval appended to a
      durable log so that the operator can later see how many agents actually ran
      in parallel instead of trusting a single accumulated total.
    '''
    metadata {
      priority 'must'
      depends_on ''
      decisions ''
      edge_cases 'app quits while cards are WORKING; same card re-enters WORKING many times; remote card intervals carry their host'
    }
  }
  us-001 -> sys.interval_log 'delivered by'

  us-002 = story 'US-002: Read a day of concurrency stats' {
    #must
    description '''
      As an operator, I want to ask for any day's peak concurrency and agent-hours
      so that capacity planning rests on measured parallelism.
    '''
    metadata {
      priority 'must'
      depends_on 'US-001'
      decisions ''
      edge_cases 'day with no intervals; interval spanning midnight; overlapping intervals from one card (restart races)'
    }
  }
  us-002 -> sys.stats_readout 'delivered by'
}

views {
  dynamic view us-001-flow {
    title 'US-001: Record every WORKING interval durably'
    description '''
      A card leaves WORKING; the interval that until now was folded into a sum is
      also appended to the durable log.
    '''

    sys.board_shell -> sys.card_model 'card transitions out of WORKING' {
      notes '''
        `with(state:at:)` computes the closing interval
        (`workingSince` -> `transitionDate`) exactly as today.
      '''
    }
    sys.board_shell -> sys.interval_log 'reports the closed interval' {
      notes '''
        **AC-1** — every completed WORKING interval produces a durable record with
        card identity, start, and end that survives an app restart.

        **AC-3** — a remote card's record carries its host, so per-machine
        concurrency stays separable.
      '''
    }
    sys.interval_log -> sys.interval_store 'appends one JSONL line' {
      notes '''
        **AC-2** — overlapping intervals from different cards land as separate,
        unmerged records with their true boundaries.
      '''
    }
    sys.board_shell -> sys.interval_log 'app termination closes open intervals' {
      notes '''
        **AC-4** — quitting while cards are WORKING closes their open intervals at
        termination time and records them; no silent loss.
      '''
    }
  }

  dynamic view us-002-flow {
    title 'US-002: Read a day of concurrency stats'
    description '''
      The operator asks for a day; the readout sweeps the interval log and answers
      with peak concurrency and agent-hours.
    '''

    operator -> sys.stats_readout 'asks for stats for day X' {
      notes '''
        Reachable from the installed app's CLI — not only from tests.
      '''
    }
    sys.stats_readout -> sys.interval_store 'sweeps intervals touching day X'
    operator <- sys.stats_readout 'peak concurrency + agent-hours' {
      notes '''
        **AC-1** — peak concurrency equals the maximum number of simultaneously
        open intervals; agent-hours equal the summed durations clipped to the day.

        **AC-2** — a day with no recorded intervals reports zeros, not an error.
      '''
    }
  }
}
