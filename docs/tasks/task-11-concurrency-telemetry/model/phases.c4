// phases.c4 — task-11-concurrency-telemetry implementation plan shape.
// Step-level detail (files, statuses) lives in ../progress.yaml `phases:`.

model {
  phase-01 = phase 'Phase 01: Interval log capture' {
    description '''
      WorkIntervalLog store + BoardShell wiring: every closed WORKING interval
      (including app-termination closes) lands in work-intervals.jsonl.
    '''
    metadata {
      effort 'M'
      stories 'US-001'
      risks 'transition seams are many (detector, manual drop, teardown, hydration): route ALL closes through one BoardShell choke point or intervals silently leak'
    }
  }

  phase-02 = phase 'Phase 02: Concurrency readout' {
    description '''
      Sweep-line stats over the log (peak concurrency, agent-hours per day),
      reachable from the sich CLI.
    '''
    metadata {
      effort 'S'
      stories 'US-002'
      risks ''
    }
  }

  phase-01 -> phase-02 'unblocks'
  phase-01 -> us-001 'delivers'
  phase-02 -> us-002 'delivers'
}

views {
  view phases {
    title 'task-11: implementation plan'
    include phase-01, phase-02
    include us-001 with { navigateTo us-001-flow }
    include us-002 with { navigateTo us-002-flow }
  }
}
