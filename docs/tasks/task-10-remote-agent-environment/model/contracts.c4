// contracts.c4 — the interfaces task-10 creates or changes.
// Full prose (tables, error cases, byte-exactness notes) survives in
// ../code-changes/*.md; this is the reviewable shape and the frozen contract.
//
// RENAME NOTE: identifiers here are POST-rename (SICH_CARD_ID, sich_host,
// ~/.sich/events.jsonl). The legacy markdown still says "ghostling".

model {
  extend sys.ssh_cmd {
    destination_api = component 'destination(for:)' {
      #new
      description '''
        THE chokepoint. Trim, check the destination grammar, return the token —
        or throw. Every ssh emitter obtains its destination token only from here;
        no emitter interpolates host, user or `target` into an argv itself.
      '''
      metadata {
        contract_kind 'function'
        contract '''
          public static func destination(for spec: RemoteTmuxSpec) throws -> String

          Validates THE EXACT STRING APPENDED, post-trim — never `spec.target`,
          which composes the UNTRIMMED host and therefore diverges.

          grammar:
            destination := [ user "@" ] host [ ":" port ]
            host        := hostname | ipv4 | "[" ipv6 "]"

          rules:
            - must not begin with "-" after trimming (an ssh OPTION in the
              destination position executes LOCALLY — this is the live hole:
              -oProxyCommand=sh -c ... has no "@" and no trailing :<int>, so it
              survives parse() whole and reaches ssh unchecked)
            - bracketed IPv6 accepted ([::1], user@[fe80::1%en0]) — Tailscale
              hands out IPv6, so [A-Za-z0-9.-] would refuse a real host
            - empty post-trim -> Invalid.emptyHost

          throws: RemoteTmuxCommand.Invalid.invalidDestination(String)
            associated value = the rejected token verbatim as composed
            (post-trim, pre-append) — not the reason, not the host field alone
        '''
        errors '''
          Invalid is nested on RemoteTmuxCommand (NOT on RemoteTmuxSpec) and
          conforms to CustomStringConvertible; the new case MUST extend the
          description switch — a case with no description is a dialog with no
          message. Text: Destination "<token>" looks like an ssh option, not a
          host. Remove the leading dash.
        '''
        files 'app/Sources/SichCore/RemoteTmuxCommand.swift'
      }
    }

    argv_api = component 'ssh argv emitters' {
      description '''
        Four thin compositions, all of the same shape:
        ["/usr/bin/ssh"] + options + [try destination(for: spec)] + [remoteCommand].
        argv(for:) exists; relayArgv / installArgv / probeArgv are new.
      '''
      metadata {
        contract_kind 'function'
        contract '''
          public static func argv(for spec: RemoteTmuxSpec) throws -> [String]     // card, US-004
          public static func relayArgv(for spec: RemoteTmuxSpec) throws -> [String] // US-003
          public static func installArgv(for spec: RemoteTmuxSpec, script: …) throws -> [String] // US-005
          public static func probeArgv(for spec: RemoteTmuxSpec) throws -> [String] // US-005

          emitted commands:
            card    ssh -t <dest> "tmux new-session -A -s <name>
                      'tmux set-environment SICH_CARD_ID <uuid>;
                       SICH_CARD_ID=<uuid> exec $SHELL -il'"
            relay   ssh -o ServerAliveInterval=15 -o ServerAliveCountMax=3 <dest>
                      'tail -n 200 -F ~/.sich/events.jsonl'
            install ssh <dest> 'cat > ~/.claude/sich-forward.sh'  (bytes on STDIN)
            probe   ssh <dest> 'cat ~/.sich/... 2>/dev/null'      (NO -t)

          also: delete the dead store `var target = spec.target` — it is what made
          the untrimmed/trimmed divergence easy to miss.
        '''
        constraints '''
          BYTE-EXACTNESS (probe AND install, because staleVersion is a SHA-256 of
          the script bytes): neither channel may allocate a PTY — a PTY rewrites
          LF to CRLF and every host then reads "hooks outdated" forever, and
          argv(for:) hardcodes -t so the obvious copy ships the bug. Install
          transfers bytes VERBATIM on stdin, never interpolated into a remote
          shell word (the forwarder contains $HOME, $SICH_CARD_ID, $file, $@ —
          an unquoted heredoc expands them on the far side).

          QUOTING boundary is remoteQuoted (four nesting levels: ssh > sh > tmux
          > sh), NOT sanitizeSessionName, which folds only . : space tab and
          never touches a quote.

          port / identityFile are safe by EMISSION ORDER, not by field property:
          both are positionally consumed by a preceding -p / -i. Any refactor
          that emits one without its flag reopens the hole.

          Both halves of the card command are required: set-environment binds
          LATER panes (Ctrl-b c); the launch command binds only the first shell.
          new-session -e needs tmux >= 3.2 (Ubuntu 20.04 ships 3.0a) so it is not
          a safe foundation under "remote OS: both/varies".
        '''
        files 'app/Sources/SichCore/RemoteTmuxCommand.swift'
      }
    }

    parse_api = component 'RemoteTmuxSpec.parse' {
      #existing
      description '''
        Stays Optional and NON-throwing. Making it throw would change 7 call
        sites and would put the guard where it cannot live: a spec built
        directly never passes through parse. It MAY return nil for an
        option-shaped destination — that is a UI nicety, not the guarantee.
      '''
      metadata {
        contract_kind 'function'
        contract 'public static func parse(destination:sessionName:remoteDir:) -> RemoteTmuxSpec?'
        files 'app/Sources/SichCore/RemoteTmuxCommand.swift'
      }
    }
  }

  extend sys.firewall {
    classify_api = component 'PoolFirewall.classify' {
      description '''
        Today it gates the headless check behind argv[0] == "claude", and "ssh"
        is not "claude" — so an ssh argv carrying `claude -p` returns
        .interactive uninspected. Extension: when the executable is ssh, inspect
        the REMOTE-COMMAND operand too.
      '''
      metadata {
        contract_kind 'function'
        contract '''
          public static func classify(_ argv: [String]) throws -> Pool

          ssh branch:
            scope   only the remote-command operand, never the options
            scan    TOKENIZED, never a substring search for "claude" over the
                    joined argv — a tmux session named claude-work must pass
            error   reuses PoolViolation.headlessClaudeForbidden(flag:)
            label   MANDATORY in-source comment: best-effort and deliberately
                    NOT sound. The structural guarantee is destination(for:) plus
                    "argvs are generated from constrained specs, never supplied".
                    The real failure mode is a future reader assuming soundness.
        '''
        constraints '''
          reopenShell already routes through classify (SessionRegistry), but ssh
          has never reached it: shellCommand always returns /bin/sh -c ... . So
          US-006 AC-5 is a TIGHTENING of an existing gate — the contract is that
          the new remote-restore branch routes through the same chokepoint rather
          than building an argv beside it.

          A human typing `claude -p` in their own remote pane is NOT prevented,
          and nothing should try. The invariant protects the operator from OUR
          automation.
        '''
        files 'app/Sources/SichCore/PoolFirewall.swift'
      }
    }
  }

  extend sys.relay {
    event_channel = component 'Remote hook event channel' {
      #new
      description '''
        The wire format is the EXISTING hook line, unchanged, plus one field we
        add ourselves at ingestion. Two line kinds share the channel and are told
        apart by sich_event_type.
      '''
      metadata {
        contract_kind 'event'
        contract '''
          transport: ssh <dest> tail -n 200 -F ~/.sich/events.jsonl, read in
          memory. A remote line is NEVER appended to the local sink.

          kind A — state hook: hook_event_name (required), session_id (required,
            RAW), cwd (optional, remote absolute path, NOT host-qualified),
            timestamp (OPTIONAL — absent means stamped with local arrival time),
            sich_card_id (spliced by the forwarder only when the env var is set),
            tool_name / tool_input.command (read only to promote PreToolUse to
            testRunStart).

          kind B — turn diff: sich_event_type == "turn_diff" (a line without it
            is not a diff), session_id (SANITIZED via tr -cd, unlike kind A —
            any join across the two kinds crosses a sanitization boundary),
            iteration (increments per UserPromptSubmit, NOT per diff, so it is
            monotonic but not unique per diff), timestamp (second granularity),
            cwd_base64, diff_base64 (undecodable means the whole line is nil),
            session_diff_base64, sich_card_id.

          added by us: sich_host — stamped AT INGESTION, because the payload
          carries no hostname field and provenance exists for exactly one instant.
        '''
        constraints '''
          Dedup is CONTENT-BASED, never a byte cursor (a rotated remote file
          restarts the offset). The dedup memory is bounded. The harm the dedup
          prevents is state REGRESSION, not duplication.
        '''
        files 'app/Sources/SichCore/ (new relay supervisor + normalizer intake)'
      }
    }
  }

  extend sys.host_state {
    install_state = component 'RemoteHookInstallState + CardState.unreachable' {
      #new
      description '''
        Two probe-derived facts that must never be collapsed into each other, and
        never cached: is the link up, and are the remote hooks ours.
      '''
      metadata {
        contract_kind 'function'
        contract '''
          enum RemoteHookInstallState: installed | notInstalled | staleVersion | unknown
            installed     probe read the remote forwarder, bytes match ours
            notInstalled  probe ran, found nothing            — ACTIONABLE
            staleVersion  probe read it, bytes DIFFER         — ACTIONABLE
            unknown       the PROBE ITSELF failed             — inert, and it is
                          NOT installed; collapsing the two is the lie

          comparand: SHA-256 of the script bytes (this is what makes the install
          and probe channels correctness-critical — see argv_api constraints).

          CardState.unreachable (new case)
            rawValue        "unreachable"  (String-Codable, additive for decode)
            needsAttention  FALSE — an unreachable host is not an agent asking
                            for you; lighting attention would dilute the one
                            signal the product exists to protect
            fallbacks       nil (existing default for non-done)

          surface: a host chip on SessionCard
            installed     roman@host                          dim, inert
            notInstalled  roman@host - hooks not installed     click installs
            staleVersion  roman@host - hooks outdated          click updates
            unknown       roman@host - hook status unknown     inert
        '''
        constraints '''
          TESTING RULE (non-negotiable in this repo): the chip is custom-drawn on
          the layer-backed card surface and asserted on real state — never via
          cacheDisplay or CALayer.render, which do not faithfully composite and
          are non-evidence for a visual AC.
        '''
        files 'app/Sources/SichCore/RemoteHookInstallState.swift; app/Sources/SichApp/SessionCard.swift'
      }
    }
  }

  extend sys.registry {
    spec_snapshot = component 'PaneSnapshot.remote' {
      #new
      description '''
        Persist the SPEC, not the argv. A format that cannot name a command
        cannot smuggle one — the guarantee stays structural instead of moving
        into a code path DD-004 would have to defend forever.
      '''
      metadata {
        contract_kind 'function'
        contract '''
          struct RemoteSpecSnapshot: Codable
            host          String   required, REVALIDATED on decode through the
                                   destination grammar
            user          String?
            sessionName   String   required
            port          Int?
            identityFile  String?
            remoteDir     String?

          PaneSnapshot.remote: RemoteSpecSnapshot?   — a NEW OPTIONAL FIELD, and
          deliberately NO version bump: a version mismatch is IGNORED rather than
          migrated, so bumping would discard every persisted pane.

          restore: rebuild the argv through the SAME constructor (argv(for:)),
          which routes through destination(for:).

          recents become host-qualified (new format).
        '''
        errors '''
          remote absent (old snapshot) -> decodes nil -> local pane, unchanged.
          host fails the destination grammar -> the pane is DROPPED, not restored
          as a local shell. Falling back to a local shell IS the shipped bug.
        '''
        constraints '''
          resolveCwd keeps its local-path assumption as a silent $HOME fallback
          rather than a compile error — exactly how the shipped bug happened.
          Bought down with a regression test rather than types. The full
          SessionLocation enum is DEFERRED, not discounted: this task adds call
          sites written against projectDir: String, so promoting later is
          strictly more expensive.
        '''
        files 'app/Sources/SichCore/SessionRegistry.swift'
      }
    }
  }

  sys.ssh_cmd.argv_api -> sys.ssh_cmd.destination_api 'try destination(for: spec)'
  sys.ssh_cmd.parse_api -> sys.ssh_cmd.destination_api 'may reuse the grammar (nicety)'
  sys.ssh_cmd.argv_api -> sys.firewall.classify_api 'classify(argv) before spawn'
  sys.relay -> sys.ssh_cmd.argv_api 'relayArgv(for:)'
  remote_log -> sys.relay.event_channel 'lines, tailed and stamped with sich_host'
  sys.relay.event_channel -> sys.normalizer 'SignalEvent / turn diff'
  sys.installer -> sys.ssh_cmd.argv_api 'installArgv / probeArgv'
  sys.installer -> sys.host_state.install_state 'probe result'
  sys.relay -> sys.host_state.install_state 'transport up/down -> unreachable'
  sys.host_state.install_state -> sys.card 'host chip'
  sys.registry.spec_snapshot -> sys.ssh_cmd.argv_api 'rebuild on restore'
}

views {
  view contracts {
    title 'task-10: interface contracts'
    description '''
      The chokepoint is `destination(for:)`. Four emitters, one grammar, one
      firewall — plus the persisted spec that keeps the guarantee structural.
    '''
    include sys.ssh_cmd, sys.ssh_cmd.*, sys.firewall, sys.firewall.*,
      sys.relay, sys.relay.*, sys.host_state, sys.host_state.*,
      sys.registry, sys.registry.*, sys.installer, sys.normalizer, sys.card
  }
}
