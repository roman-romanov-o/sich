// phases.c4 — the delivery plan. Step-level detail (files, statuses) lives in
// ../progress.yaml; the full prose is in ../implementation-plan/phase-0*.md.
//
// The spine: guard the transport (01) -> write the events (02) -> carry them (03)
// -> land them on the right card (04) -> tell the truth when it breaks (05) ->
// open the door (06).

model {
  phase-01 = phase 'Phase 01: ssh Command Firewall' {
    description '''
      Make it structurally impossible to GENERATE an ssh argv that smuggles
      headless work, and close the live `-oProxyCommand=` hole reachable from
      Cmd-Shift-R in shipped code today. Nothing downstream may emit an ssh
      command until this lands.
    '''
    metadata {
      effort 'M'
      stories 'US-001'
      decisions 'DD-004'
      why_first '''
        DD-004 is a HARD PREREQUISITE for the relay (03) and the restore (05):
        both add ssh-emitting call sites, and the restore one runs at launch from
        data on disk with NO HUMAN PRESENT. Built last, every intermediate phase
        would ship an unguarded ssh emitter and the constraint would be enforced
        by code review only.
      '''
      dod '''
        US-001 all six ACs green; AC-1 and AC-2 proven RED BEFORE GREEN;
        `swift test` count strictly increases (no test deleted to make the suite
        pass); `swift build` warning-clean.
      '''
      risks '''
        The plausible-wrong guard: validating `spec.target` (untrimmed) instead of
        the exact token appended (trimmed) passes a payload straight through.
        AC-4 exists to catch precisely that.
      '''
    }
  }

  phase-02 = phase 'Phase 02: Portable Forwarder and Remote Install' {
    description '''
      Make hooks installable on a remote GNU/Linux host from the app, emitting the
      same JSONL a local host emits, and surface each host install state on its
      card. Nothing emits an event until this phase runs — it is the source end of
      the pipe the next phase carries.
    '''
    metadata {
      effort 'L'
      stories 'US-002; US-005'
      decisions 'DD-004'
      why_here '''
        Install (US-005) must precede the relay (US-003): a relay tailing a file
        no forwarder writes is green against an empty file forever. And a PORTABLE
        forwarder (US-002) must precede installing it, because a macOS-only
        forwarder on Linux fails at first run, not at review — the turn-diff block
        is currently gated on `plutil`.
      '''
      risks '''
        Byte-exactness: staleVersion is a SHA-256 of the script bytes, so a PTY on
        the install or probe channel (LF -> CRLF) or an unquoted heredoc makes
        every host read "hooks outdated" forever.
      '''
    }
  }

  phase-03 = phase 'Phase 03: The Relay' {
    description '''
      Carry the remote JSONL to the laptop over an in-memory ssh tail -F relay,
      stamping each line host at ingestion, without ever writing a remote line
      into the local sink. This is DD-001.
    '''
    metadata {
      effort 'L'
      stories 'US-003'
      decisions 'DD-001; DD-004'
      out_of_scope '''
        WHICH card a line lands on is Phase 04 — this phase proves lines ARRIVE
        and are host-stamped. Dead-connection state and dedup are Phase 05.
      '''
    }
  }

  phase-04 = phase 'Phase 04: The Card Join' {
    description '''
      Bind each relayed, host-stamped line to the CORRECT card, so a remote agent
      moves its card running -> waiting -> done exactly as a local one does. This
      is where the headline outcome of the task first exists. This is DD-002.
    '''
    metadata {
      effort 'L'
      stories 'US-004'
      decisions 'DD-002'
      risks '''
        The load-bearing half is the SESSION env: without `set-environment`, a
        pane the operator opens later with Ctrl-b c is unbound while the terminal
        works fine — a silent failure. Needs a real tmux to test
        (`brew install tmux`; skip loudly when absent).
      '''
    }
  }

  phase-05 = phase 'Phase 05: Resilience — dead connections, replay, restart' {
    description '''
      Make the board tell the truth when the channel misbehaves: a dead connection
      reads `unreachable` (not a frozen `running`), a reconnect never duplicates
      or rewinds a card, and a remote card survives an app restart.
    '''
    metadata {
      effort 'L'
      stories 'US-006; US-007; US-008'
      decisions 'DD-001; DD-003'
      risks '''
        The restore path rebuilds an argv at launch with no human present — it
        MUST route through the Phase 01 chokepoint rather than building an argv
        beside it. `resolveCwd` keeps its silent $HOME fallback, which is exactly
        how the shipped local-shell bug happened; bought down with a regression
        test, not with types.
      '''
    }
  }

  phase-06 = phase 'Phase 06: The Door — remote host and folder picker' {
    description '''
      A first-class create-palette flow to pick WHERE a card runs (this laptop or
      a remote box) and WHICH folder, from a host-qualified recents list with a
      hand-entry fallback — then retire the Cmd-Shift-R alert LAST.
    '''
    metadata {
      effort 'L'
      stories 'US-009'
      decisions 'DD-003'
      why_last '''
        Cmd-Shift-R is the demo path this task uses through Phases 03-05 (open it,
        run claude, watch the card move). Retiring it early would make unfinished
        palette UI a hard prerequisite for demonstrating all the transport work.
        A Must-Have story sits at the end on purpose.
      '''
    }
  }

  phase-01 -> phase-02 'install/probe argvs must pass the firewall'
  phase-01 -> phase-03 'the relay argv passes the firewall'
  phase-01 -> phase-04 'the tmux argv passes the firewall'
  phase-01 -> phase-05 'the restore argv passes the firewall'
  phase-01 -> phase-06 'a typed destination is caller data, validated here'
  phase-02 -> phase-03 'something writes the file the relay tails'
  phase-02 -> phase-04 'identity is installed onto the pane'
  phase-03 -> phase-04 'lines arrive, host-stamped'
  phase-04 -> phase-05 'a live, correctly-bound card to protect'
  phase-04 -> phase-06 'a card created here must bind'
  phase-05 -> phase-06 'the palette writes the spec restore reads'

  phase-01 -> us-001 'delivers'
  phase-02 -> us-002 'delivers'
  phase-02 -> us-005 'delivers'
  phase-03 -> us-003 'delivers'
  phase-04 -> us-004 'delivers'
  phase-05 -> us-006 'delivers'
  phase-05 -> us-007 'delivers'
  phase-05 -> us-008 'delivers'
  phase-06 -> us-009 'delivers'
}

views {
  view phases {
    title 'task-10: implementation plan'
    description '''
      Six phases, strictly ordered by what would otherwise ship unguarded or
      untestable. Every phase depends on Phase 01, because every one of them adds
      an ssh-emitting call site.
    '''
    include phase-01, phase-02, phase-03, phase-04, phase-05, phase-06
    include us-001, us-002, us-003, us-004, us-005, us-006, us-007, us-008, us-009
  }
}
