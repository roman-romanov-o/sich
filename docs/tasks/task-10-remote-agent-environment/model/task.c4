// task.c4 — task-10-remote-agent-environment (TASK-10a):
// watch an agent running on ANOTHER machine as if it ran locally.
//
// Migrated from the legacy markdown artifacts (task-description.md, user-stories/,
// design-decisions/, code-changes/, test-specs/, implementation-plan/), which stay
// on disk as frozen reference prose. This model + ../progress.yaml are authoritative.
//
// RENAME NOTE: planning predates the Ghostling -> Sich rename (commit 7108ddb).
// Every identifier below is the POST-rename one: SICH_CARD_ID, ~/.sich/events.jsonl,
// sich_host, SichCore / SichApp. The legacy markdown still says "ghostling".

model {
  operator = actor 'Operator' {
    description '''
      The developer running agent sessions from the board. Already runs work on
      remote boxes over Tailscale; today those cards are a terminal and nothing more.
    '''
  }

  sys = container 'Sich' {
    description '''
      Close the remote gap: a card whose tmux session lives on another host must
      move running -> waiting -> done, show turn diffs, survive a restart, and say
      so honestly when the connection dies — without ever spawning headless work.
    '''
    metadata {
      goals '''
        remote hook telemetry reaches the laptop; state lands on the right card;
        turn diffs work under GNU userland; hooks installable on a remote host with
        a truthful per-host install state; remote cards survive restart; a dead
        connection reads unreachable; pick host + folder at card creation
      '''
      non_goals '''
        no remote file browser (recents list only); no agent-side changes; no
        multi-user/shared-board; no cross-machine quota aggregation; no new remote
        binary and no inbound listener
      '''
      constraints '''
        watcher-not-spawner: the app never generates headless `claude -p` work, on
        any machine (PoolFirewall is the chokepoint); observe-only sink (DD-002 of
        task-03) survives — no listener, no port, no reply; macOS 14+ / AppKit;
        remote OS is "both/varies" so the forwarder must be portable
      '''
    }

    firewall = component 'PoolFirewall' {
      #existing
      description '''
        The economic invariant in code: a managed session may only draw the
        interactive pool. Today it only inspects argv[0] == "claude", so an ssh
        argv walks through uninspected.
      '''
      metadata {
        files 'app/Sources/SichCore/PoolFirewall.swift'
      }
    }

    ssh_cmd = component 'RemoteTmuxCommand' {
      #existing
      description '''
        Pure builder of `ssh -t [opts] <destination> tmux new-session -A -s <name>`.
        The single place ssh argvs are generated — and today the place a destination
        that is really an ssh option (`-oProxyCommand=...`) reaches ssh unchecked.
      '''
      metadata {
        files 'app/Sources/SichCore/RemoteTmuxCommand.swift'
      }
    }

    installer = component 'HookInstaller' {
      #existing
      description '''
        Writes the shell forwarder and patches ~/.claude/settings.json. Local-only
        today, and the forwarder gates its whole turn-diff block on `plutil`, which
        does not exist under GNU userland.
      '''
      metadata {
        files 'app/Sources/SichApp/HookInstaller.swift'
      }
    }

    relay = component 'RemoteEventRelay' {
      #new
      description '''
        Per-host supervisor of an `ssh ... tail -n 200 -F ~/.sich/events.jsonl`
        child. Stamps sich_host at ingestion and feeds the normalizer IN MEMORY —
        it never writes a remote line into the local sink.
      '''
      metadata {
        files 'app/Sources/SichCore/ (new relay supervisor)'
      }
    }

    normalizer = component 'HookNormalizer' {
      #existing
      description 'Turns a raw hook line into a SignalEvent the session store folds.'
      metadata {
        files 'app/Sources/SichCore/HookNormalizer.swift'
      }
    }

    sessions = component 'HookSessionStore' {
      #existing
      description 'Folds signal events into per-session state (running/waiting/done).'
      metadata {
        files 'app/Sources/SichCore/HookSessionStore.swift'
      }
    }

    registry = component 'SessionRegistry' {
      #existing
      description '''
        Owns PTY panes and their on-disk snapshots. Restore currently rebuilds a
        LOCAL shell for a remote card, because the snapshot only kept `user@host`
        as a directory.
      '''
      metadata {
        files 'app/Sources/SichCore/SessionRegistry.swift'
      }
    }

    board = component 'BoardShell' {
      #existing
      description 'Merges owned + observed sessions onto cards and drives the poll.'
      metadata {
        files 'app/Sources/SichApp/BoardShell.swift'
      }
    }

    card = component 'SessionCard' {
      #existing
      description 'The custom-drawn card surface; owner of the repo chip and (new) the host chip.'
      metadata {
        files 'app/Sources/SichApp/SessionCard.swift'
      }
    }

    palette = component 'CreateCardPalette' {
      #existing
      description 'Card creation. Remote is a hidden Cmd-Shift-R NSAlert today, not a first-class choice.'
      metadata {
        files 'app/Sources/SichApp/CreateCardPalette.swift'
      }
    }

    host_state = component 'RemoteHostState' {
      #new
      description '''
        CardState.unreachable plus RemoteHookInstallState
        (installed / not-installed / stale-version / unknown), both probe-derived,
        never cached, never collapsed.
      '''
      metadata {
        files 'app/Sources/SichCore/RemoteHookInstallState.swift'
      }
    }
  }

  local_log = store 'Local ~/.sich/events.jsonl' {
    #existing
    description 'The laptop sink the app already tails. Remote lines must NEVER be written here.'
  }

  remote_log = store 'Remote ~/.sich/events.jsonl' {
    #new
    description 'The sink on the far side, written and rotated by the remote forwarder.'
  }

  remote_host = external 'Remote host (GNU/Linux or macOS)' {
    description 'Reached over Tailscale/ssh with an existing identity. No new binary lands here.'
  }

  remote_tmux = external 'tmux on the remote host' {
    description '`new-session -A` attaches if the session exists, else creates it — restart survival.'
  }

  openssh = external 'OpenSSH client' {
    description 'The only transport. Options in the destination position execute LOCALLY — hence the guard.'
  }

  operator -> sys.palette 'creates a card, picks host + folder'
  operator -> sys.card 'reads state, acts on the host chip'
  sys.palette -> sys.ssh_cmd 'hands a constrained spec'
  sys.registry -> sys.ssh_cmd 'rebuilds the argv on restore'
  sys.ssh_cmd -> sys.firewall 'classify(argv) before spawn'
  sys.ssh_cmd -> openssh 'ssh -t <dest> tmux new-session -A'
  openssh -> remote_tmux 'attaches the pane (SICH_CARD_ID in the session env)'
  sys.installer -> remote_host 'installs + probes the portable forwarder'
  remote_host -> remote_log 'forwarder appends hook lines'
  sys.relay -> sys.firewall 'classify(relay argv)'
  sys.relay -> remote_log 'ssh ... tail -n 200 -F'
  sys.relay -> sys.normalizer 'host-stamped lines, in memory'
  sys.board -> local_log 'tails the local sink (unchanged)'
  local_log -> sys.normalizer 'local lines'
  sys.normalizer -> sys.sessions 'SignalEvent'
  sys.sessions -> sys.board 'per-session state'
  sys.board -> sys.card 'renders the card'
  sys.installer -> sys.host_state 'probe result'
  sys.relay -> sys.host_state 'transport up/down'
  sys.host_state -> sys.card 'host chip + unreachable'
}

views {
  view task-context {
    title 'task-10: remote agent environment'
    description '''
      Success: a card whose session runs on another machine behaves like a local one —
      it moves running -> waiting -> done, shows turn diffs, survives a restart, tells
      the truth when the link dies — and no path in the app can generate headless work.
    '''
    include *, sys.*
    // Story cards jump straight to their flow when clicked.
    include us-001 with { navigateTo us-001-flow }
    include us-002 with { navigateTo us-002-flow }
    include us-003 with { navigateTo us-003-flow }
    include us-004 with { navigateTo us-004-flow }
    include us-005 with { navigateTo us-005-flow }
    include us-006 with { navigateTo us-006-flow }
    include us-007 with { navigateTo us-007-flow }
    include us-008 with { navigateTo us-008-flow }
    include us-009 with { navigateTo us-009-flow }
  }
}
