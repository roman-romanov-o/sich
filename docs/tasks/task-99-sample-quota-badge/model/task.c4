// task.c4 — task-99-sample-quota-badge: show a per-card quota badge on the board.

model {
  user = actor 'Board operator' {
    description 'Runs several agent sessions and wants per-card quota cost at a glance.'
  }

  sys = container 'ghostling' {
    description '''
      Add a small quota badge to each board card showing the share of the 5-hour
      window that card's session has consumed, so the operator can spot the
      expensive session without drilling in.
    '''
    metadata {
      goals 'per-card quota badge; live refresh with the quota poll'
      non_goals 'no per-turn cost breakdown; no Codex/Gemini badges yet'
      constraints 'watcher-not-spawner: read existing quota state only, never probe per card'
    }

    quota = component 'QuotaStore' {
      #existing
      description 'Polls the measured /usage source and publishes pool state.'
      metadata {
        files 'app/Sources/GhostlingCore/QuotaStore.swift'
      }
    }

    badge = component 'CardQuotaBadge' {
      #new
      description 'Custom-drawn badge on SessionCard rendering the per-card share.'
      metadata {
        files 'app/Sources/GhostlingApp/SessionCard.swift'
      }
    }
  }

  claude = external 'Claude /usage source' {
    description 'The measured OAuth usage endpoint the quota poll already reads.'
  }

  user -> sys.badge 'glances at the card'
  sys.badge -> sys.quota 'reads per-card share'
  sys.quota -> claude 'polls (existing path)'
}

views {
  view task-context {
    title 'task-99: per-card quota badge'
    description '''
      Success: every card shows a badge within one poll cycle; no new network
      calls are introduced; the badge degrades to "—" when the share is unknown.
    '''
    include *, sys.*
  }
}
