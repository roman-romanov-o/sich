// task.c4 — task-100-reap-pty-zombies: PTYSession.terminate() must never leave a zombie.
// Planned via /saha:quick (2026-08-28) from a live power-consumption drill-down.

model {
  operator = actor 'Board operator' {
    description 'Runs Sich for days; noticed the app accumulating <defunct> children.'
  }

  sys = container 'Sich' {
    description '''
      Bug: `PTYSession.terminate()` sends SIGKILL and then polls
      `waitpid(WNOHANG)` for at most 100 × 1 ms. A Node-based CLI with a large
      heap regularly takes longer than 100 ms to be torn down by the kernel, so
      the loop expires, `childPID` is set to -1, and nobody ever reaps the child.
      It stays a zombie for the app's lifetime.

      Observed 2026-08-28: ~230 `<defunct>` children under one Sich process
      after 48 h (~5/hour), in pairs at the same second — the hidden `/usage`
      probes (`claude`, `agent --trust`, `agy`) that `TUIUsageProbe.scrape`
      terminates every 5 min. Card shells closed via BoardShell hit the same
      path.

      Zombies cost no CPU, but they leak pid-table entries indefinitely and
      make `ps`-based tooling (CutoverGuard, the E2E harness) noisy.

      Fix shape: keep the short synchronous attempt (fast path), and when it
      expires hand the pid to an asynchronous reaper — a
      `DispatchSource.makeProcessSource(identifier:eventMask:.exit)` whose
      handler calls `waitpid(pid, …, 0)` and cancels itself — instead of
      forgetting the pid. Never block the caller (terminate() is called from
      the main thread on quit and card close).
    '''
    metadata {
      goals 'no PTYSession child is ever left <defunct> after terminate(); caller never blocks'
      non_goals 'no change to finish() (blocking reap for self-exiting children); no change to probe cadence'
      constraints 'one-reader-per-fd invariant untouched; SIGKILL stays (shell may ignore hangup); swift test must stay spawn-free for probes'
    }

    pty = component 'PTYSession' {
      #existing
      description 'forkpty owner. terminate() is the buggy path; pollExit()/finish() are the other two reap paths.'
      metadata {
        files 'app/Sources/SichCore/PTYSession.swift'
        symbols 'PTYSession.terminate() (lines ~233-248), PTYSession.finish(), PTYSession.pollExit()'
      }
    }

    probe = component 'TUIUsageProbe' {
      #existing
      description 'Hidden-pty /usage scraper; calls session.terminate() in a defer every 5 min per agent (3 agents). The main zombie producer.'
      metadata {
        files 'app/Sources/SichCore/TUIUsageProbe.swift'
        symbols 'TUIUsageProbe.scrape (line ~102), drive (line ~153)'
      }
    }

    shell = component 'BoardShell' {
      #existing
      description 'Calls pty.terminate() on quit, card close, and remote re-attach (5 call sites). Same leak on a slow-dying agent.'
      metadata {
        files 'app/Sources/SichApp/BoardShell.swift'
        symbols 'lines ~245, ~279, ~599, ~2314, ~2374'
      }
    }

    tests = component 'PTY tests' {
      #existing
      description 'Where the regression test belongs. Existing PTY tests already spawn real children (/bin/sh, sleep), so a slow-dying child is testable here.'
      metadata {
        files 'app/Tests/SichCoreTests/PTYReadTests.swift, app/Tests/SichCoreTests/PTYBackpressureTests.swift'
      }
    }
  }

  kernel = external 'XNU process teardown' {
    description 'Delivers SIGKILL synchronously but tears the process down asynchronously; big Node heaps exceed 100 ms.'
  }

  sys.probe -> sys.pty 'terminate() every 5 min × 3 agents'
  sys.shell -> sys.pty 'terminate() on quit / close'
  sys.pty -> kernel 'kill(SIGKILL) then waitpid(WNOHANG) ×100'
}

views {
  view task-context {
    title 'task-100: reap SIGKILLed pty children'
    description '''
      Success: `ps -Ao ppid,stat | awk '$1==<sich pid> && $2 ~ /Z/'` stays
      empty after any number of probe cycles and card closes, and
      terminate() still returns in ≤ ~100 ms.
    '''
    include *, sys.*
    include us-001 with { navigateTo us-001-flow }
  }
}
