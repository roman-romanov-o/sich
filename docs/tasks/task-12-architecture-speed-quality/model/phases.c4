// phases.c4 — task-12 delivery slices. Step detail lives in ../progress.yaml.

model {
  phase-01 = phase 'Phase 01: Board calm + persistence off the hot path' {
    description 'Face key without timestamps, in-place card updates, debounced off-main task-book writes, archive split, codex scrape throttle.'
    metadata { effort 'M' stories 'US-001' risks 'in-place update must keep column moves and ordering identical; archive split changes the on-disk shape (no migration: rewrite once at launch)' }
  }
  phase-02 = phase 'Phase 02: Terminal render path' {
    description 'Link cache, dirty-row draw, buffer reuse + row hashes, raw-key glyph cache, CTFontDrawGlyphs.'
    metadata { effort 'L' stories 'US-002' risks 'visual regressions are not provable by cacheDisplay (see memory: unfaithful capture) — pixel ACs route to human eyes' }
  }
  phase-03 = phase 'Phase 03: Robustness' {
    description 'Async bounded ssh probes, relay backoff, settings.json safety, visible persistence failures, fd/deinit hygiene.'
    metadata { effort 'M' stories 'US-003, US-004, US-005' risks 'HookInstaller tests must cover the unparsable-file path red first' }
  }
  phase-04 = phase 'Phase 04: Card state reducer' {
    description 'Extract CardStateReducer + split render from side effects; retire the side-maps it subsumes.'
    metadata { effort 'L' stories 'US-006' risks 'CardStatusRealAgentE2ETests and CARD-STATUS.md rules are the regression net; run the real-agent suite before merging' }
  }

  phase-01 -> phase-02 'then'
  phase-02 -> phase-03 'then'
  phase-03 -> phase-04 'then'
  phase-01 -> us-001 'delivers'
  phase-02 -> us-002 'delivers'
  phase-03 -> us-003 'delivers'
  phase-03 -> us-004 'delivers'
  phase-03 -> us-005 'delivers'
  phase-04 -> us-006 'delivers'
}

views {
  view phases {
    title 'task-12: implementation plan'
    include phase-01, phase-02, phase-03, phase-04
    include us-001 with { navigateTo us-001-flow }
    include us-002 with { navigateTo us-002-flow }
    include us-003 with { navigateTo us-003-flow }
    include us-004 with { navigateTo us-004-flow }
    include us-005 with { navigateTo us-005-flow }
    include us-006 with { navigateTo us-006-flow }
  }
}
