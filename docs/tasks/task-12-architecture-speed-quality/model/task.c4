// task.c4 — task-12-architecture-speed-quality: act on the 2026-09-02 architecture review.
// Source of every finding: research/architecture-review-2026-09-02.md (numbers below = its items).

model {
  operator = actor 'Board operator' {
    description 'Runs 5-15 agent cards at once, drills into terminals, keeps Sich open for days.'
  }

  sys = container 'Sich' {
    description '''
      A whole-app review found that the user-visible slowness and the
      quality risks share a few roots:

      - The drill-in terminal repaints far more than the damage warrants
        (link regexes per row per frame, one union damage rect, NSString
        typesetting per colour run, full grid re-extract, contrast maths
        before the cache).
      - The board rebuilds every card view in a column on any hook event
        because the column diff key includes `updatedAt`, and the task book
        is rewritten synchronously on main at pump cadence.
      - Remote cards block the main actor on ssh probes with an unbounded
        wait after SIGKILL.
      - `~/.claude/settings.json` can be silently replaced and task-book
        write failures are swallowed.
      - Sessions leak fds/children and relays retry forever.
      - `BoardShell` (3019 lines) holds 8-10 overlapping copies of card state.
    '''
    metadata {
      goals 'drill-in typing stays under one frame at 60 Hz; a 15-card board does not rebuild on every event; the app never blocks on ssh; user config and the task book are never silently damaged'
      non_goals 'no new features; no change to the watcher-not-spawner pool discipline; zombie reaping stays in task-100'
      constraints 'Swift 6 strict concurrency; one-reader-per-fd invariant; libghostty-vt FFI stays the only VT source; interaction ACs must dispatch real events'
    }

    surface = component 'TerminalSurface' {
      #existing
      description 'Drill-in NSView: read loop, row diff, draw path, link underlines, glyph attrs.'
      metadata {
        files 'app/Sources/SichApp/TerminalSurface.swift, app/Sources/SichApp/TerminalFrameCoordinator.swift'
        symbols 'startReading, refresh, rowChanged, draw(_:), drawRow, drawLinkUnderlines, drawRun, glyphAttrs'
      }
    }

    grid = component 'Terminal grid + links' {
      #existing
      description 'RenderState.snapshot re-extracts the viewport each frame; TerminalLinkDetector runs two regexes per line.'
      metadata {
        files 'app/Sources/SichCore/TerminalGrid.swift, app/Sources/SichCore/TerminalLinks.swift, app/Sources/SichCore/ContrastColor.swift, app/Sources/SichCore/Terminal.swift'
      }
    }

    board = component 'BoardView' {
      #existing
      description 'renderColumn diffs CardFace{card, chip}; BoardCard.== includes updatedAt so the diff rarely short-circuits.'
      metadata {
        files 'app/Sources/SichApp/BoardView.swift, app/Sources/SichCore/BoardCard.swift, app/Sources/SichApp/SessionCard.swift'
      }
    }

    shell = component 'BoardShell' {
      #existing
      description '3019-line coordinator: pump, persistence, card state, remote probes, notifications, archive.'
      metadata {
        files 'app/Sources/SichApp/BoardShell.swift'
        symbols 'pumpBackgroundSessions, reconcileCodexChoiceScreens, persistTasks, remoteSessionConflict, remoteSessionIsLost, refresh'
      }
    }

    store = store 'BoardTaskStore' {
      #existing
      description 'Whole-book (backlog + board + archive) atomic pretty-printed JSON write on every mutation.'
      metadata {
        files 'app/Sources/SichCore/TaskStore.swift'
      }
    }

    remote = component 'Remote probes + relays' {
      #existing
      description 'SSHCommandRunner.bounded (unbounded final wait), RemoteSessionProbe.presence (sync), RemoteEventRelay (5 s retry forever).'
      metadata {
        files 'app/Sources/SichCore/RemoteHookInstallState.swift, app/Sources/SichCore/RemoteSessionKey.swift, app/Sources/SichCore/RemoteEventRelay.swift'
      }
    }

    hooks = component 'HookInstaller' {
      #existing
      description 'Reads/writes ~/.claude/settings.json; treats an unparsable file as empty and overwrites non-atomically.'
      metadata {
        files 'app/Sources/SichApp/HookInstaller.swift'
        symbols 'readConfig, config(from:), writeConfig'
      }
    }

    pty = component 'PTYSession' {
      #existing
      description 'forkpty owner; no deinit; read DispatchSource cancelled after the fd may already be closed.'
      metadata {
        files 'app/Sources/SichCore/PTYSession.swift'
      }
    }
  }

  ghostty = external 'libghostty-vt' {
    description 'VT state machine; the only source of cells. FFI cost per cell is what item 4 reduces.'
  }
  sshd = external 'Remote hosts (ssh)' {
    description 'Latency and hangs here must never reach the main actor.'
  }
  claudecfg = external '~/.claude/settings.json' {
    description 'User-owned file; must survive our writes byte-for-byte except the hooks block.'
  }

  operator -> sys.surface 'types / reads'
  operator -> sys.board 'watches cards'
  sys.surface -> sys.grid 'snapshot() per frame'
  sys.grid -> ghostty 'row/cell FFI'
  sys.shell -> sys.board 'renderColumn'
  sys.shell -> sys.store 'persistTasks (sync, main)'
  sys.shell -> sys.remote 'presence() (sync, main)'
  sys.remote -> sshd 'ssh'
  sys.hooks -> claudecfg 'read / overwrite'
  sys.shell -> sys.pty 'pump 60 Hz'
}

views {
  view task-context {
    title 'task-12: architecture speed + quality'
    description '''
      Success: typing in a busy drill-in stays under 16 ms per frame; a
      hook event on a 15-card board touches only the changed card; opening
      a remote card never freezes the window; a corrupt settings.json is
      left alone and reported; a failed task-book write is visible.
    '''
    include *, sys.*
    include us-001 with { navigateTo us-001-flow }
    include us-002 with { navigateTo us-002-flow }
    include us-003 with { navigateTo us-003-flow }
    include us-004 with { navigateTo us-004-flow }
    include us-005 with { navigateTo us-005-flow }
    include us-006 with { navigateTo us-006-flow }
  }
}
